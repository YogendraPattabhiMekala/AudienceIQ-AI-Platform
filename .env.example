# AudienceIQ local / demo configuration
# Copy to .env and adjust. Never commit real credentials.

# --- Required for the product application (Next.js + PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Demo mode uses the local PostgreSQL product store, synthetic data,
# and a deterministic governed agent when no LLM key is present.
DEMO_MODE=true

# Optional: enable LLM-backed query planning (OpenAI-compatible).
# If unset, Ask AudienceIQ uses the deterministic governed planner.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional Python FastAPI warehouse / pipeline service
BACKEND_PORT=8080
PRODUCT_API_URL=http://localhost:3000

# Warehouse adapter: postgres (demo) | snowflake (production)
WAREHOUSE_ADAPTER=postgres

# Snowflake — production only. Leave blank for demo.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=AUDIENCEIQ
SNOWFLAKE_SCHEMA=SEMANTIC
SNOWFLAKE_ROLE=

# Temporal — production workflow orchestration. Demo uses in-process fallback.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=audienceiq-pipelines

# AWS (production serverless). Never commit real keys.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
